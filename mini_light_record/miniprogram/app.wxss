page {
  background: #f7f8fa;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  min-height: 100%;
}

.page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* —— 全局过渡与触控 —— */
.tap-dim {
  opacity: 1;
  transition: opacity 0.15s ease, transform 0.15s ease, background-color 0.15s ease;
}
.tap-dim-hover {
  opacity: 0.72 !important;
}
.tap-scale {
  transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.15s ease;
}
.tap-scale-hover {
  transform: scale(0.96);
  opacity: 0.88;
}
.tap-bg-hover {
  background-color: #f5f6f8 !important;
}
.fade-in {
  animation: qj-fade-in 0.22s ease;
}
@keyframes qj-fade-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: none; }
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 28rpx;
  margin: 24rpx 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.04);
}

/* 色与字号 */
.primary { color: #ff7a45; }
.title-lg {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  letter-spacing: 0.5rpx;
}
.title-md {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}
.muted {
  color: #8a9199;
  font-size: 24rpx;
}
.label {
  color: #8a9199;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.amount-expense {
  color: #e85d4c;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.amount-income {
  color: #2fbf6b;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

/* 布局 */
.row {
  display: flex;
  align-items: center;
}
.between { justify-content: space-between; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 20rpx; }

/* 分段切换 */
.seg {
  display: flex;
  margin: 24rpx 28rpx 8rpx;
  padding: 6rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.04);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  color: #8a9199;
  font-size: 28rpx;
  transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
}
.seg-item:active { transform: scale(0.98); }
.seg-item.on {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.28);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #ff7a45, #ff945f);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 26rpx;
  font-weight: 600;
  font-size: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 69, 0.28);
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.btn-primary:active { opacity: 0.88; transform: scale(0.99); }
.btn-outline {
  margin-top: 20rpx;
  border: 2rpx solid rgba(255, 122, 69, 0.45);
  color: #ff7a45;
  background: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 24rpx;
  font-weight: 600;
  font-size: 30rpx;
  transition: background-color 0.15s ease, transform 0.15s ease;
}
.btn-outline:active { background: #fff6f1; transform: scale(0.99); }
.btn-ghost {
  color: #ff7a45;
  font-size: 26rpx;
  font-weight: 500;
  transition: opacity 0.15s ease;
}
.btn-ghost:active { opacity: 0.65; }

.empty {
  text-align: center;
  padding: 72rpx 32rpx;
  color: #8a9199;
  font-size: 26rpx;
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #fff3ed;
  color: #ff7a45;
  font-size: 40rpx;
  transition: transform 0.2s ease;
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0b5bd;
}

.loading-tip {
  text-align: center;
  padding: 48rpx 32rpx;
  color: #b0b5bd;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #f0f2f5;
  margin: 8rpx 0;
}

.tag {
  display: inline-block;
  background: #fff3ed;
  color: #ff7a45;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.tag-gray {
  background: #f2f3f5;
  color: #646a73;
}

.icon-circle {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff3ed;
  color: #ff7a45;
  font-weight: 650;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: background-color 0.18s ease, color 0.18s ease, transform 0.15s ease, box-shadow 0.18s ease;
}
.icon-circle.income {
  background: #eaf9f0;
  color: #2fbf6b;
}

/* 列表条目通用 */
.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 8rpx;
  margin: 0 -8rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
  transition: background-color 0.15s ease;
}
.list-row:last-child { border-bottom-color: transparent; }
.list-row-hover {
  background-color: #f7f8fa !important;
}

/* 表单输入焦点 */
.input-focusable {
  transition: background-color 0.18s ease, box-shadow 0.18s ease;
  border-radius: 12rpx;
}
.input-focused {
  background: #fff8f4;
  box-shadow: inset 0 0 0 2rpx rgba(255, 122, 69, 0.35);
}
