.record {
  padding-bottom: calc(480rpx + env(safe-area-inset-bottom));
}

.amount-card { padding: 28rpx 32rpx 24rpx; }
.amount-label { margin-bottom: 8rpx; }
.amount-display {
  text-align: right;
  color: #ff7a45;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
  min-height: 88rpx;
  line-height: 88rpx;
  transition: color 0.2s ease, transform 0.12s ease;
}
.amount-display.is-income { color: #2fbf6b; }
.amount-display.pulse { transform: scale(1.02); }
.symbol {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: 650;
}
.num { font-size: 64rpx; }

.cat-card {
  padding-bottom: 16rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.cat-card.is-fading {
  opacity: 0.4;
  transform: translateY(8rpx);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.child-grid {
  animation: child-in 0.22s ease;
}
@keyframes child-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: none; }
}
.grid-item {
  width: 25%;
  text-align: center;
  padding: 12rpx 8rpx 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
}
.grid-item .icon-circle {
  margin: 0 auto 10rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
}
.grid-item .icon-circle.on {
  background: #ff7a45;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 69, 0.3);
  transform: scale(1.06);
}
.grid-item .icon-circle.income.on {
  background: #2fbf6b;
  box-shadow: 0 8rpx 18rpx rgba(47, 191, 107, 0.28);
}
.grid-name {
  font-size: 22rpx;
  color: #646a73;
  transition: color 0.15s ease;
}
.grid-item.active .grid-name {
  color: #ff7a45;
  font-weight: 600;
}
.grid-item.active.is-income .grid-name {
  color: #2fbf6b;
}

.meta-row {
  padding: 28rpx 32rpx;
  transition: background-color 0.15s ease;
}
.meta-val { font-size: 28rpx; font-weight: 550; color: #1f2329; }
.chev { font-size: 28rpx; }

.note-card {
  padding: 8rpx 24rpx;
  transition: background-color 0.18s ease, box-shadow 0.18s ease;
}
.note-card.input-focused {
  background: #fff8f4;
  box-shadow: inset 0 0 0 2rpx rgba(255, 122, 69, 0.28);
}
.note-input {
  height: 80rpx;
  font-size: 28rpx;
}
.note-ph { color: #b0b5bd; }

.keyboard {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.06);
  border-radius: 28rpx 28rpx 0 0;
  z-index: 20;
}
.kb-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.kb-main {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.kb-left { flex: 3; }
.kb-left .kb-row:last-child { margin-bottom: 0; }
.key {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 550;
  background: #f7f8fa;
  border-radius: 18rpx;
  color: #1f2329;
  user-select: none;
  transition: background-color 0.12s ease, transform 0.12s ease;
}
.key-hover {
  background: #e8eaed !important;
  transform: scale(0.96);
}
.key.action {
  font-size: 28rpx;
  color: #646a73;
  font-weight: 600;
}
.key.action.soft { font-size: 26rpx; }
.key.save {
  flex: 1;
  align-self: stretch;
  height: auto;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ff945f, #ff7a45);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 69, 0.3);
  border-radius: 18rpx;
  transition: opacity 0.18s ease, transform 0.15s ease, filter 0.18s ease;
}
.save-hover {
  opacity: 0.9;
  transform: scale(0.98);
}
.key.save.disabled {
  background: #d8dce2;
  color: #fff;
  box-shadow: none;
  filter: grayscale(0.15);
  opacity: 0.85;
}

.child-label { margin-top: 8rpx; }
.empty-child {
  padding: 12rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: #8a9199;
}
.empty-child.warn { color: #e85d4c; }
.icon-circle.sm {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
}
.parent-grid .grid-item { padding-bottom: 8rpx; }
