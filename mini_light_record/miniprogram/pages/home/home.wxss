.home { padding-bottom: 48rpx; }

.hero {
  background: linear-gradient(145deg, #ff7a45 0%, #ff9a6b 55%, #ffb087 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(255, 122, 69, 0.28);
  padding: 36rpx 32rpx 32rpx;
}
.hero-month {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}
.hero-book {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.hero-chip {
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: background-color 0.15s ease, transform 0.15s ease;
}
.hero-chip-hover {
  background: rgba(255, 255, 255, 0.38) !important;
  transform: scale(0.97);
}

.hero-expense { margin-top: 36rpx; }
.hero-expense-label {
  font-size: 26rpx;
  opacity: 0.92;
}
.hero-expense-num {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.hero-expense-num .yen {
  font-size: 36rpx;
  margin-right: 6rpx;
  font-weight: 650;
}

.hero-sub {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  align-items: flex-start;
}
.hero-sub-label {
  font-size: 22rpx;
  opacity: 0.85;
}
.hero-sub-num {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.hero-sub-right { width: 52%; text-align: right; }
.bar-bg {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  margin: 10rpx 0 8rpx;
  overflow: hidden;
}
.bar-fg {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
  transition: width 0.35s ease;
}

.section-head { margin-bottom: 8rpx; }
.recent-card { padding-top: 28rpx; padding-bottom: 12rpx; }

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 12rpx;
  margin: 0 -12rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
  transition: background-color 0.15s ease;
}
.item:last-child { border-bottom-color: transparent; }
.item-hover {
  background-color: #f7f8fa !important;
}
.item-meta { min-width: 0; }
.item-title {
  font-size: 28rpx;
  font-weight: 550;
  margin-bottom: 4rpx;
}
.item-amt {
  font-size: 30rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
