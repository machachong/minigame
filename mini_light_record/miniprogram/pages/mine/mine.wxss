.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(160deg, #ffffff 0%, #fff7f3 100%);
}
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.avatar-btn::after { border: none; }
.avatar-hover {
  opacity: 0.85;
  transform: scale(0.96);
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff945f, #ff7a45);
  color: #fff;
  text-align: center;
  line-height: 112rpx;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 69, 0.28);
}
.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}
.profile-info { flex: 1; min-width: 0; }
.name-wrap {
  border-radius: 12rpx;
  margin: -4rpx -8rpx 10rpx;
  padding: 4rpx 8rpx;
  transition: background-color 0.18s ease, box-shadow 0.18s ease;
}
.name-wrap.input-focused {
  background: #fff8f4;
  box-shadow: inset 0 0 0 2rpx rgba(255, 122, 69, 0.35);
}
.name-input {
  font-size: 36rpx;
  font-weight: 700;
  padding: 0;
  height: 52rpx;
  color: #1f2329;
}
.book-line { margin-bottom: 4rpx; }

.menu {
  padding: 20rpx 8rpx 8rpx;
}
.menu-group-title {
  padding: 8rpx 24rpx 12rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
  background: transparent;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
  border-radius: 16rpx;
  transition: background-color 0.15s ease;
}
.menu-item.last,
.menu-item:last-child { border-bottom: none; }
.menu-hover {
  background-color: #f7f8fa !important;
}
.chev {
  color: #b0b5bd;
  font-size: 24rpx;
}
.phone-btn {
  margin: 0;
  border-radius: 16rpx;
}
.phone-btn::after { border: none; }
.footer {
  text-align: center;
  padding: 16rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
}
