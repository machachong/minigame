# 微信小程序（正式环境必填；开发可用 MOCK_OPENID）
WX_APPID=
WX_SECRET=

# JWT 密钥，生产环境务必更换
JWT_SECRET=qingji-dev-secret-change-me

# 数据库：默认 SQLite；生产可改为 Postgres
# DATABASE_URL=sqlite:///./qingji.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/qingji
DATABASE_URL=sqlite:///./qingji.db

# 开发 mock：设置后 login 忽略真实 code2session，用此 openid
MOCK_OPENID=dev_user
# MOCK 下 getPhoneNumber / phone_code 写死的手机号
MOCK_PHONE=13800138000
