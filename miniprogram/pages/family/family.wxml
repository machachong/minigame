<view class="page family">
  <view class="card hero-mini">
    <view class="title-lg">{{book.name || '家庭账本'}}</view>
    <view class="muted meta">角色 {{book.role || '—'}} · 成员 {{book.member_count || 0}} 人</view>
  </view>

  <view class="card">
    <view class="section-title title-md">成员</view>
    <view
      class="member"
      wx:for="{{members}}"
      wx:key="user_id"
      hover-class="member-hover"
      hover-stay-time="70"
    >
      <view class="row gap-md">
        <view class="icon-circle">{{item.nickname ? item.nickname[0] : '成'}}</view>
        <view>
          <view class="member-name">{{item.nickname}}</view>
          <view class="muted">{{item.role}}{{item.phone ? ' · ' + item.phone : ''}}</view>
        </view>
      </view>
      <text
        class="danger"
        wx:if="{{canManage && item.role !== 'owner'}}"
        hover-class="tap-dim-hover"
        hover-stay-time="70"
        data-uid="{{item.user_id}}"
        bindtap="removeMember"
      >移除</text>
    </view>
    <view class="empty" wx:if="{{!members.length}}" style="padding:32rpx 0;">暂无成员</view>
  </view>

  <view class="card" wx:if="{{canInvite}}">
    <view class="section-title title-md">邀请好友</view>
    <view class="btn-primary" hover-class="tap-scale-hover" hover-stay-time="70" bindtap="inviteShare">生成分享口令</view>
    <view class="btn-outline" hover-class="tap-scale-hover" hover-stay-time="70" bindtap="invitePhone">手机号邀请</view>
    <view class="invite-box fade-in" wx:if="{{lastInvite}}">
      <view class="muted">口令</view>
      <view class="code">{{lastInvite.code}}</view>
      <view class="muted path">{{lastInvite.path}}</view>
      <view class="row gap-md invite-actions">
        <view class="btn-half btn-primary" hover-class="tap-scale-hover" hover-stay-time="70" bindtap="copyInvite">复制口令</view>
        <button class="btn-half btn-share" open-type="share" hover-class="tap-scale-hover">微信分享</button>
      </view>
    </view>
  </view>
</view>
